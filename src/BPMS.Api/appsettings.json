{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bpms;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "SecretKey": "ThisIsASecretKeyForBpmsThatIsAtLeast32CharactersLong",
    "Issuer": "BPMS",
    "Audience": "BPMS",
    "ExpiryMinutes": "60"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "bpms-files"
  },
  "OpenRouter": {
    "ApiKey": "",
    "Model": "openai/gpt-4o-mini",
    "Endpoint": "https://openrouter.ai/api/v1/chat/completions",
    "Referer": "http://localhost:5171",
    "Title": "BPMS FormGenerator"
  },
  "FileValidation": {
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".csv", ".zip", ".rar", ".7z", ".tar", ".gz"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/bpms-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}